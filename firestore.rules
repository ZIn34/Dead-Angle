rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // chats are keyed "uidA_uidB" (sorted); only those two are members
    function isMember(pair) {
      return request.auth != null && request.auth.uid in pair.split('_');
    }
    function otherOf(pair) {
      return pair.split('_')[0] == request.auth.uid ? pair.split('_')[1] : pair.split('_')[0];
    }
    // both have added each other
    function mutual(pair) {
      return request.auth.uid in get(/databases/$(database)/documents/users/$(otherOf(pair))).data.friends
          && otherOf(pair) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends;
    }

    // username -> account. Anyone can check if a name is taken; a name can be
    // claimed once, by the account it points to, and never changed.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && name.matches('^[a-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // profiles: signed-in players can see each other (for friends lists);
    // only you can write your own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // party invites: anyone signed in can drop one in your inbox as
    // themselves; only you can read or clear your inbox.
    match /invites/{toUid}/items/{inviteId} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, delete: if request.auth != null && request.auth.uid == toUid;
    }

    // public matches: anyone signed in can list them; only the host can
    // open, update or close theirs.
    match /lobbies/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && resource.data.host == request.auth.uid
                    && request.resource.data.host == request.auth.uid;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }

    // friend chat: only the two people in it can read it; only mutual
    // friends can write, as themselves, up to 200 characters. Messages
    // cannot be edited or deleted after sending.
    match /chats/{pair}/msgs/{msg} {
      allow read: if isMember(pair);
      allow create: if isMember(pair) && mutual(pair)
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 200;
      allow update, delete: if false;
    }
  }
}
