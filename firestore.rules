rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // username -> account. Anyone can check if a name is taken; a name can be
    // claimed once, by the account it points to, and never changed.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && name.matches('^[a-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // profiles: signed-in players can see each other (for friends lists);
    // only you can write your own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // party invites: anyone signed in can drop one in your inbox as
    // themselves; only you can read or clear your inbox.
    match /invites/{toUid}/items/{inviteId} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, delete: if request.auth != null && request.auth.uid == toUid;
    }

    // public matches: anyone signed in can list them; only the host can
    // open, update or close theirs.
    match /lobbies/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && resource.data.host == request.auth.uid
                    && request.resource.data.host == request.auth.uid;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
  }
}
